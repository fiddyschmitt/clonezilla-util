<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>clonezilla_util</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>

    <!-- THE version. Single source of truth: sets AssemblyVersion/FileVersion/InformationalVersion,
         which the CommandLineParser help header uses and which Program.cs reads back at runtime for
         its startup banner. Bump this one line to release a new version. -->
    <Version>2.10.1</Version>
    <!-- keep InformationalVersion a clean "2.10.0" (no git-hash suffix) so both surfaces match. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib7Zip\lib7Zip.csproj" />
    <ProjectReference Include="..\libClonezilla\libClonezilla.csproj" />
    <ProjectReference Include="..\libCommon\libCommon.csproj" />
    <ProjectReference Include="..\libDokan\libDokan.csproj" />
    <ProjectReference Include="..\libPartclone\libPartclone.csproj" />
  </ItemGroup>

</Project>
